PROCEDURE "getExpenseDetails"(
    OUT APPROVALSTATUS TABLE (STATUSCODE VARCHAR(10), STATUSNAME VARCHAR(20)),
    OUT EXPENSEDATA TABLE (EXPENSEDATE DATE, AMOUNT DECIMAL(10, 2), REMARKS VARCHAR(255)) 
)
  LANGUAGE SQLSCRIPT 
  SQL SECURITY INVOKER 
  --DEFAULT SCHEMA <default_schema_name>
    READS SQL DATA AS 
BEGIN 
  /*************************************
  Write your procedure logic
  *************************************/
   APPROVALSTATUS = SELECT "STATUSCODE" AS STATUSCODE, "STATUSNAME" AS STATUSNAME FROM TRAVEL_MANAGEMENT_APPROVALSTATUS;
   EXPENSEDATA = SELECT "EXPENSEDATE" AS EXPENSEDATE, "AMOUNT" AS AMOUNT, "REMARKS" AS REMARKS FROM TRAVEL_MANAGEMENT_EXPENSES;
END