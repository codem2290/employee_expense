{
  "name": "employee_expense",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/hana-client": "^2.28.21",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "@sap/hdi-deploy": "5.6.1",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-travel_request_ui": "cds watch --open com.travel.request.travelrequestui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "[development]": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "mocked",
          "users": {
            "employeeTester@tester.sap.com": {
              "password": "12345",
              "roles": [
                "Employees"
              ]
            },
            "managerTester@tester.sap.com": {
              "password": "12345",
              "roles": [
                "Managers"
              ]
            }
          }
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": "xsuaa"
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    },
    "hana": {
      "deploy-format": "hdbtable"
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/travel_request_ui"
  ]
}
